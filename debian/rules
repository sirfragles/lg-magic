#!/usr/bin/make -f

%:
	dh $@ --with dkms

# Build only the tools here; the module itself is built by DKMS on the
# target machine (dh_dkms ships the source into /usr/src/lg-magic-1.0).
override_dh_auto_build:
	$(MAKE) tools

override_dh_auto_install:
	$(MAKE) DESTDIR=$(CURDIR)/debian/lg-magic-dkms install
